{
	"name": "obsidian-tab-groups",
	"version": "1.7.2",
	"description": "Chrome-style tab groups for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"check-translations": "node scripts/check-translations.mjs",
		"prepare": "node scripts/install-git-hooks.mjs",
		"test:e2e": "npm run build && wdio run ./wdio.conf.mts",
		"test:e2e:wsl": "node scripts/e2e-wsl.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tabs",
		"tab-groups"
	],
	"author": "imsang27",
	"repository": {
		"type": "git",
		"url": "https://github.com/imsang27/obsidian-tab-groups.git"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.17",
		"@wdio/cli": "^9.32.0",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^3.2.4",
		"wdio-obsidian-reporter": "^3.3.0",
		"wdio-obsidian-service": "^3.3.0",
		"webdriverio": "^9.32.0"
	}
}
